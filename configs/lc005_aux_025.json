{
  "seed": 42,
  "slots": 2,
  "pretrained": true,
  "precision": "bf16",
  "epochs": 40,
  "workers": 4,
  "batch_size": 2,
  "crop_mode": "random",
  "count_threshold": 0.3,
  "localization_min_score": 0.05,
  "lr": 0.0002,
  "lr_schedule": "warmup_cosine",
  "min_lr": 0.00002,
  "warmup_fraction": 0.05,
  "fixed_training_horizon": true,
  "patience": 0,
  "stage": "pilot",
  "label_policy": "shanghaitech_lc001_drop_only_logged_out_of_bounds",
  "variant": "shared_2",
  "backbone_bn": "train",
  "loop_embedding": false,
  "gradient_checkpointing": false,
  "density_weight": 0,
  "early_loss_weight": 0.25
}
