{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoopCrowd Stage 0 point-candidate audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "crop_size_px",
    "crop_seed",
    "unlabeled",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "enum": [
        "real",
        "synthetic"
      ]
    },
    "crop_size_px": {
      "const": 512
    },
    "crop_seed": {
      "type": "integer"
    },
    "unlabeled": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset",
          "split",
          "image_count"
        ],
        "properties": {
          "dataset": {
            "type": "string",
            "minLength": 1
          },
          "split": {
            "const": "test"
          },
          "image_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "quantiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0",
        "p25",
        "p50",
        "p75",
        "p90",
        "p95",
        "p99",
        "p100"
      ],
      "properties": {
        "p0": {
          "type": "number",
          "minimum": 0
        },
        "p25": {
          "type": "number",
          "minimum": 0
        },
        "p50": {
          "type": "number",
          "minimum": 0
        },
        "p75": {
          "type": "number",
          "minimum": 0
        },
        "p90": {
          "type": "number",
          "minimum": 0
        },
        "p95": {
          "type": "number",
          "minimum": 0
        },
        "p99": {
          "type": "number",
          "minimum": 0
        },
        "p100": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "overflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lost_points",
        "point_loss_rate"
      ],
      "properties": {
        "lost_points": {
          "type": "integer",
          "minimum": 0
        },
        "point_loss_rate": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cells",
        "occupied_cells",
        "occupied_fraction",
        "max_points_per_cell",
        "cell_histogram",
        "overflow"
      ],
      "properties": {
        "total_cells": {
          "type": "integer",
          "minimum": 1
        },
        "occupied_cells": {
          "type": "integer",
          "minimum": 0
        },
        "occupied_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_points_per_cell": {
          "type": "integer",
          "minimum": 0
        },
        "cell_histogram": {
          "type": "object",
          "required": [
            "0"
          ],
          "patternProperties": {
            "^(0|[1-9][0-9]*)$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "overflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "1",
            "2",
            "4",
            "8"
          ],
          "properties": {
            "1": {
              "$ref": "#/$defs/overflow"
            },
            "2": {
              "$ref": "#/$defs/overflow"
            },
            "4": {
              "$ref": "#/$defs/overflow"
            },
            "8": {
              "$ref": "#/$defs/overflow"
            }
          }
        }
      }
    },
    "grids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "4",
        "8"
      ],
      "properties": {
        "4": {
          "$ref": "#/$defs/grid"
        },
        "8": {
          "$ref": "#/$defs/grid"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "width",
        "height",
        "crop_origin_xy",
        "source_head_count",
        "head_count",
        "nearest_neighbor_px",
        "grids"
      ],
      "properties": {
        "image_id": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "crop_origin_xy": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "source_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "head_count": {
          "type": "integer",
          "minimum": 0
        },
        "nearest_neighbor_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "grids": {
          "$ref": "#/$defs/grids"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "split",
        "mode",
        "image_count",
        "source_head_count",
        "head_count",
        "width_px",
        "height_px",
        "heads_per_image",
        "nearest_neighbor_px",
        "grids"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test",
            "all"
          ]
        },
        "mode": {
          "enum": [
            "full-image",
            "crop-512"
          ]
        },
        "image_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_head_count": {
          "type": "integer",
          "minimum": 0
        },
        "head_count": {
          "type": "integer",
          "minimum": 0
        },
        "width_px": {
          "$ref": "#/$defs/quantiles"
        },
        "height_px": {
          "$ref": "#/$defs/quantiles"
        },
        "heads_per_image": {
          "$ref": "#/$defs/quantiles"
        },
        "nearest_neighbor_px": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantiles"
            },
            {
              "type": "null"
            }
          ]
        },
        "grids": {
          "$ref": "#/$defs/grids"
        },
        "images": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/image"
          }
        }
      }
    }
  }
}
